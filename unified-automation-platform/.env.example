# Unified Automation Platform Configuration
# Copy this file to .env and configure your settings

# Platform Configurations
# Each platform has its own configuration section

# 1. OpenComputerUse Platform
OPENCOMPUTERUSE_BASE_URL=http://localhost:8001
OPENCOMPUTERUSE_API_KEY=your_opencomputeruse_api_key
OPENCOMPUTERUSE_TIMEOUT=30000

# 2. UI-TARS Desktop Platform
UITARS_API_URL=ws://localhost:3005
UITARS_PYTHON_PATH=/opt/anaconda3/envs/uitars/bin/python
UITARS_WORKSPACE_PATH=./workspace
UITARS_VISION_MODEL=microsoft/Florence-2-large

# 3. Gbox Platform
GBOX_BASE_URL=http://localhost:8080
GBOX_EXECUTABLE_PATH=./gbox/gbox
GBOX_CONTAINER_NAME=ai-automation
GBOX_API_KEY=your_gbox_api_key

# 4. Bytebot Platform
BYTEBOT_BASE_URL=http://localhost:4000
BYTEBOT_WS_URL=ws://localhost:4001
BYTEBOT_API_KEY=your_bytebot_api_key
BYTEBOT_TIMEOUT=60000

# 5. Ai-Browser Platform (if available)
AIBROWSER_API_URL=http://localhost:3006
AIBROWSER_EXECUTABLE=./ai-browser/dist/main.js
AIBROWSER_PROFILE_DIR=./profiles

# Application Settings
APP_PORT=3000
APP_WS_PORT=3001
APP_DEBUG=true
APP_LOG_LEVEL=debug

# Security Settings
JWT_SECRET=your_unique_jwt_secret_here
ENCRYPTION_KEY=your_32_character_encryption_key
API_RATE_LIMIT=100

# Database Settings (if needed)
DATABASE_URL=./data/database.db
DATABASE_ENCRYPTION_KEY=

# External API Keys (optional for enhanced features)
OPENAI_API_KEY=
ANTROPIC_API_KEY=
GOOGLE_API_KEY=

# Development Settings
NODE_ENV=development
DISABLE_SSL_VERIFICATION=false
PROXY_SETTINGS=
