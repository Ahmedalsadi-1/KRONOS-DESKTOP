{
  "name": "mcp-communication-testing-framework",
  "version": "1.0.0",
  "description": "Comprehensive MCP communication testing framework for all agents",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:throughput": "jest --testPathPattern=throughput",
    "test:error-handling": "jest --testPathPattern=error-handling",
    "test:streaming": "jest --testPathPattern=streaming",
    "test:agent-interaction": "jest --testPathPattern=agent-interaction",
    "test:stress": "jest --testPathPattern=stress",
    "test:benchmark": "jest --testPathPattern=benchmark",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^0.5.0",
    "axios": "^1.6.0",
    "express": "^4.18.0",
    "socket.io": "^4.7.0",
    "socket.io-client": "^4.7.0",
    "ws": "^8.14.0",
    "node-cron": "^3.0.0",
    "prometheus-api-metrics": "^3.2.2",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.0",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^2.0.0",
    "@types/ws": "^8.5.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.0.0",
    "eslint": "^8.50.0",
    "prettier": "^3.0.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "src/**/*.ts",
      "!src/**/*.d.ts"
    ],
    "coverageDirectory": "coverage",
    "coverageReporters": ["text", "lcov", "html"],
    "testMatch": [
      "<rootDir>/src/**/__tests__/**/*.test.ts",
      "<rootDir>/src/**/*.test.ts"
    ],
    "setupFilesAfterEnv": ["<rootDir>/src/test/setup.ts"]
  }
}