{
  "name": "kronos-unified-automation-platform",
  "version": "1.0.0",
  "description": "KRONOS Unified Electron interface for managing AI computer automation projects",
  "main": "src/main/kronos-main.js",
  "homepage": "./",
  "scripts": {
    "start": "concurrently \"npm run start:electron\" \"npm run start:renderer\"",
    "start:electron": "cross-env NODE_ENV=development electron .",
    "start:renderer": "craco start",
    "build": "craco build",
    "build:electron": "electron-builder",
    "build:all": "npm run build && npm run build:electron",
    "test": "craco test",
    "test:electron": "jest --testPathPattern=tests/unit/",
    "eject": "react-scripts eject",
    "lint": "eslint src --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint src --ext .js,.jsx,.ts,.tsx --fix",
    "pack": "electron-builder --dir",
    "dist": "npm run build && electron-builder"
  },
  "keywords": [
    "electron",
    "automation",
    "ai",
    "unified-platform"
  ],
  "author": "AI Automation Team",
  "license": "MIT",
  "dependencies": {
    "@babel/runtime": "^7.28.4",
    "@tanstack/react-query": "^4.29.0",
    "axios": "^1.6.0",
    "clsx": "^2.0.0",
    "electron-store": "^8.1.0",
    "lucide-react": "^0.263.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.8.0",
    "socket.io-client": "^4.7.0",
    "tailwindcss": "^3.2.0",
    "uuid": "^13.0.0",
    "ws": "^8.14.0"
  },
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@testing-library/jest-dom": "^5.16.5",
    "@testing-library/react": "^13.4.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^7.6.0",
    "cross-env": "^7.0.3",
    "electron": "^28.0.0",
    "electron-builder": "^24.0.0",
    "eslint": "^8.0.0",
    "eslint-plugin-react": "^7.32.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "jest": "^29.5.0",
    "nodemon": "^2.0.20",
    "postcss": "^8.4.0",
    "react-scripts": "5.0.1",
    "spectron": "^19.0.0",
    "typescript": "^5.0.0"
  },
  "build": {
    "appId": "com.kronos.ai.unified-platform",
    "productName": "KRONOS Unified Automation Platform",
    "directories": {
      "output": "dist"
    },
    "files": [
      "build/**/*",
      "node_modules/**/*",
      "src/main/**/*"
    ],
    "extraResources": [],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": "dmg"
    },
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
