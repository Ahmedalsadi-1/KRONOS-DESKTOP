{
  "name": "@kronos/plugin-ecosystem",
  "version": "1.0.0",
  "description": "Comprehensive plugin ecosystem for KRONOS platform with discovery, marketplace, validation, and lifecycle management",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc && npm run build:runtime",
    "build:runtime": "esbuild src/runtime/*.ts --bundle --platform=node --outdir=dist --format=cjs --target=es2022",
    "build:docs": "typedoc src/**/*.ts --out docs/api --theme markdown --excludePrivate",
    "dev": "tsx watch src/**/*.ts --out-dir=dist --format=cjs",
    "test": "jest --coverage",
    "lint": "eslint src/**/*.ts --fix",
    "validate": "node dist/validation.js --config validation.config.json",
    "security-scan": "node dist/security-scanner.js --directory ./plugins",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@types/node": "^20.0.0",
    "express": "^4.18.0",
    "joi": "^17.0.0",
    "semver": "^7.5.0",
    "chokidar": "^3.5.0",
    "ws": "^8.0.0",
    "axios": "^1.6.0",
    "tar": "^6.2.0",
    "crypto": "^1.0.1",
    "helmet": "^7.1.0",
    "cors": "^2.8.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0",
    "jest": "^29.0.0",
    "eslint": "^8.0.0",
    "prettier": "^3.0.0",
    "typedoc": "^0.25.0",
    "tsx": "^4.7.0",
    "esbuild": "^0.19.0",
    "@types/jest": "^29.0.0"
  },
  "keywords": [
    "kronos",
    "plugin",
    "ecosystem",
    "marketplace",
    "validation",
    "security",
    "mcp"
  ],
  "author": "KRONOS Platform",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kronos/plugin-ecosystem"
  }
}