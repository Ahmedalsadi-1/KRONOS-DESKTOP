# Bytebot Unified Infrastructure Environment Variables

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=bytebot
DATABASE_USER=postgres
DATABASE_PASSWORD=your-database-password
DATABASE_SSL=false
DATABASE_MAX_CONNECTIONS=20

# ===========================================
# REDIS CACHE CONFIGURATION
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TTL=3600

# ===========================================
# JWT AUTHENTICATION
# ===========================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=bytebot-auth
JWT_AUDIENCE=bytebot-services

# ===========================================
# FILE STORAGE (Choose one provider)
# ===========================================

# S3 Configuration
FILE_STORAGE_PROVIDER=s3
AWS_S3_BUCKET=bytebot-files
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key

# Local File System Configuration (alternative to S3)
# FILE_STORAGE_PROVIDER=local
# FILE_STORAGE_LOCAL_PATH=./uploads
# FILE_STORAGE_BASE_URL=http://localhost:3000/files

# File Storage Limits
FILE_STORAGE_MAX_SIZE=10485760
FILE_STORAGE_ALLOWED_TYPES=image/*,application/pdf,text/*

# ===========================================
# SERVICE REGISTRY
# ===========================================
SERVICE_NAME=your-service-name
SERVICE_ID=unique-service-instance-id
SERVICE_VERSION=1.0.0
SERVICE_HOST=localhost
SERVICE_PORT=3000
SERVICE_PROTOCOL=http
SERVICE_HEARTBEAT_INTERVAL=30000
SERVICE_TTL=60000

# ===========================================
# API CONFIGURATION
# ===========================================
API_PREFIX=api
API_VERSION=v1
CORS_ORIGIN=*
CORS_CREDENTIALS=true

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100

# ===========================================
# SECURITY SETTINGS
# ===========================================
BCRYPT_ROUNDS=12
SESSION_TIMEOUT=86400000
PASSWORD_MIN_LENGTH=8

# ===========================================
# DEVELOPMENT/DEBUGGING
# ===========================================
NODE_ENV=development
LOG_LEVEL=debug

# ===========================================
# EXTERNAL SERVICE INTEGRATIONS
# ===========================================

# Email Service (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Monitoring (optional)
SENTRY_DSN=your-sentry-dsn

# Analytics (optional)
MIXPANEL_TOKEN=your-mixpanel-token

# ===========================================
# SERVICE-SPECIFIC CONFIGURATION
# ===========================================

# For bytebot-agent
ANTHROPIC_API_KEY=your-anthropic-key
OPENAI_API_KEY=your-openai-key

# For computer control services
COMPUTER_CONTROL_ENABLED=true
SCREENSHOT_QUALITY=80

# For UI service
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1